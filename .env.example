# Friend-IM 服务器配置示例：复制成 .env 再改（.env 不进 Git）。全部可选，下面是默认值。

# 宿主机上绑定的端口（只绑 127.0.0.1，前面一层反向代理挂证书）。
FRIEND_IM_PORT=8090

# 日志级别（日志只记编号、长度、耗时和错误码，不记密文、钥匙和凭证）。
FRIEND_IM_LOG=info

# 插件仓库（服务器和插件共用的 core 在里面）：默认同级目录；也可以写成带标签的 Git 地址。
FRIEND_IM_SOURCE=../hhh-friend-im
# FRIEND_IM_SOURCE=https://github.com/MagicLizi/hhh-friend-im.git#v0.1.0

# 每个账号的发送频率上限（任何 Cindy 账号都能登录，防止被刷）。
FRIEND_IM_SEND_PER_SECOND=5
FRIEND_IM_SEND_PER_MINUTE=120

# 构建用的镜像（Docker Hub 慢或连不上时换成可信的镜像来源，比如 AWS 上的 Docker 官方镜像：
# public.ecr.aws/docker/library/rust:1-slim-bookworm、public.ecr.aws/docker/library/debian:bookworm-slim）。
# FRIEND_IM_RUST_IMAGE=rust:1-slim-bookworm
# FRIEND_IM_RUNTIME_IMAGE=debian:bookworm-slim

# 直接运行程序（不用 Docker）时还会读这几项：
# FRIEND_IM_LISTEN=127.0.0.1:8090
# FRIEND_IM_DATA_DIR=/var/lib/friend-im
# 只在测试或私有部署时改认可的 Cindy 签发方：签发方=公钥地址;签发方=公钥地址
# FRIEND_IM_CINDY_ISSUERS=https://auth.cindy.app=https://auth.cindy.app/.well-known/jwks.json
